classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +date due_date
        +int duration_minutes
        +str priority
        +bool completed
        +str pet_name
        +mark_complete() Task
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() List~Task~
    }
    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
        +get_todays_schedule()
    }
    Owner "1" *-- "many" Pet : has
    Pet "1" *-- "many" Task : has
    Scheduler --> Owner : reads tasks from
